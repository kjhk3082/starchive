# Copy to .env and fill in ONE provider key. starchive auto-detects the provider.
# OpenRouter (default; uses qwen/qwen3.5-plus-20260420 unless overridden):
OPENROUTER_API_KEY=
# Or Anthropic Claude:
# ANTHROPIC_API_KEY=
# Or OpenAI:
# OPENAI_API_KEY=

# Optional overrides:
# STARCHIVE_LLM_PROVIDER=openrouter   # openrouter | anthropic | openai
# STARCHIVE_LLM_MODEL=qwen/qwen3.5-plus-20260420
